<body style="font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;">
  <div
    style="border:2px solid #2A7A7B;padding:20px;margin:10px;text-align:justify;border-top:50px solid #2A7A7B;border-bottom:50px solid #2A7A7B">
    <% if (typeof logoUrl !== 'undefined' && logoUrl) { %>
      <div style="text-align:center;margin-bottom:10px;">
        <img src="<%= logoUrl %>" alt="Logo" style="max-height:50px;" />
      </div>
    <% } %>
    <h1 style="text-align: center;">Request Demo</h1>
    <!-- <p>Region: <%= user.region %>,</p> -->
    <!-- <p>Second Name: <%= user.secondName %>,</p> -->
    <p>Full name: <%= user.fullName %>,</p>
    <p>Business Email: <%= user.businessEmail %>,</p>
    <p>Phone Number: <%= user.phoneNumber %>,</p>
    <p>Size Of Organization: <%= user.sizeOfOrganization %></p>
    <% if (user.address && user.address.trim() !== '') { %>
      <p>Address: <%= user.address %></p>
    <% } %>
    <% if (user.message && user.message.trim() !== '') { %>
      <p>Message: <%= user.message %></p>
    <% } %>
  </div>
</body>